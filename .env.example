# ------------------------------------------------------------------
# Variables d'environnement — copiez ce fichier en `.env.local`
# et renseignez les valeurs. TOUTES sont optionnelles en développement :
# sans configuration, les formulaires fonctionnent et les envois d'emails
# / uploads sont ignorés proprement (journalisés en console).
# ------------------------------------------------------------------

# URL canonique du site en production (sans slash final).
# Utilisée pour les métadonnées, le sitemap, les canonical et le JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.exemple.fr

# --- Emails (Resend) ---------------------------------------------------
# Sans RESEND_API_KEY, aucun email n'est envoyé (mode développement).
RESEND_API_KEY=
# Expéditeur vérifié dans Resend (ex. "Ma Marque <contact@exemple.fr>").
EMAIL_FROM=
# Destinataire des notifications internes (par défaut : siteConfig.email).
EMAIL_ADMIN=

# --- Stockage des fichiers (Supabase Storage) --------------------------
# Sans ces variables, les photos ne sont pas stockées (leurs métadonnées
# sont tout de même transmises dans la notification interne).
SUPABASE_URL=
# Clé service_role — SECRÈTE, uniquement côté serveur, jamais exposée au client.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket de destination (créez-le dans Supabase). Par défaut : diagnostic-uploads
SUPABASE_UPLOAD_BUCKET=diagnostic-uploads

# --- Tests end-to-end (optionnel) --------------------------------------
# Chemin d'un binaire Chromium fourni séparément (sinon : navigateurs Playwright).
# E2E_CHROMIUM=
